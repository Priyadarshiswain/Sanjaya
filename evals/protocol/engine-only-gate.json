    "modelCalls": 0,
    "networkDuringRun": false,
    "repositorySnapshots": "Pinned public commits already frozen in repositories/manifest.json.",
    "repositoryIsolation": "Each repository is cloned locally into separate native and Sanjaya snapshots.",
    "indexing": "One Sanjaya index build per repository before measured queries; native snapshots contain no index.",
    "queryRepetitions": 5,
    "routeOrder": "Alternates native-first and Sanjaya-first by repetition.",
    "nativeExecutable": "rg",
    "nativeOutput": "Compact repository-relative path:line:text rendered from ripgrep JSON events.",
    "sanjayaOutput": "Complete MCP call result including compact text content and structured content.",
    "storedEvidence": "Only paths, ranges, counts, statuses, byte sizes, and timings; no source snippets.",
    "maximumResults": 100
  },
  "scoring": {
    "targetRecall": "Fraction of preregistered evidence ranges overlapped by at least one returned candidate.",
    "candidatePrecision": "Fraction of returned candidates overlapping any preregistered evidence range.",
    "responseBytes": "UTF-8 bytes delivered to the caller after route-specific compact rendering.",
    "queryLatency": "Wall-clock duration of one rg process or one MCP tool call.",
    "amortization": "Index-build duration is divided across the five unique repository queries, never across timing repetitions.",
    "proceedCriterion": {
      "recallNonInferiority": "Mean Sanjaya target recall must be no more than 0.05 below native.",
      "materialBenefit": "Mean candidate precision improves by at least 0.15 or median response bytes are at most 75% of native.",
      "indexReadiness": "Every repository index must produce a ready state."
    }
  },
